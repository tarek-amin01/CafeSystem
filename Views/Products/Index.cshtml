@model IEnumerable<CafeSystem.Models.Product>

@{
    ViewData["Title"] = "Products";
    var categories = ViewBag.Categories as Dictionary<int, string>;
}

<h1>Products</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Available</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="~/images/products/@item.ImageUrl" style="width: 50px; height: 50px; object-fit: cover;" class="rounded" />
                }
                else
                {
                    <span>No Image</span>
                }
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @if (categories != null && categories.ContainsKey(item.CategoryId))
                {
                    <span>@categories[item.CategoryId]</span>
                }
                else
                {
                    <span>@item.CategoryId</span>
                }
            </td>
            <td>
                @item.Price.ToString("C")
            </td>
            <td>
                @item.StockQuantity
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsAvailable)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
<a asp-controller="Admin" asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
