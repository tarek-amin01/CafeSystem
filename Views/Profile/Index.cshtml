@model CafeSystem.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    // We can use the same layout
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
                <div class="card-header bg-white p-4 border-bottom-0">
                    <h2 class="cinematic-title mb-0">My Profile</h2>
                </div>
                
                <div class="card-body p-4">
                    <!-- Success Message -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Update" enctype="multipart/form-data" method="post">
                        
                        <!-- Profile Image Section -->
                        <div class="text-center mb-4">
                            <div class="position-relative d-inline-block">
                                @if (!string.IsNullOrEmpty(Model.CurrentProfileImage))
                                {
                                    <img src="~/images/profiles/@Model.CurrentProfileImage" 
                                         alt="Profile" 
                                         class="rounded-circle shadow-sm" 
                                         style="width: 150px; height: 150px; object-fit: cover; border: 4px solid #fff;">
                                }
                                else
                                {
                                    <div class="rounded-circle shadow-sm bg-light d-flex align-items-center justify-content-center text-muted"
                                         style="width: 150px; height: 150px; border: 4px solid #fff; font-size: 3rem;">
                                        👤
                                    </div>
                                }
                                
                                <!-- Hidden File Input triggered by a button or label could be fancier, but standard input is fine -->
                            </div>
                            <div class="mt-3">
                                <label asp-for="ProfileImage" class="form-label text-muted small">Update Photo</label>
                                <input asp-for="ProfileImage" class="form-control form-control-sm w-50 mx-auto" type="file" accept="image/*" />
                                <span asp-validation-for="ProfileImage" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row g-3">
                            <!-- Email (Read Only) -->
                            <div class="col-md-12">
                                <label asp-for="Email" class="form-label fw-bold opacity-75">Email Address</label>
                                <input asp-for="Email" class="form-control bg-light" readonly />
                            </div>

                            <!-- Full Name -->
                            <div class="col-md-12">
                                <label asp-for="FullName" class="form-label fw-bold">Full Name</label>
                                <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>

                            <!-- Address -->
                            <div class="col-md-12">
                                <label asp-for="Address" class="form-label fw-bold">Address</label>
                                <textarea asp-for="Address" class="form-control" rows="3" placeholder="e.g. 123 Coffee St, Bean City"></textarea>
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-premium px-5">Save Changes</button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
