@model IEnumerable<CafeSystem.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<h1>Orders</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>Date</th>
            <th>Total</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>#@item.Id</td>
                <td>@item.OrderDate.ToLocalTime()</td>
                <td>@item.TotalAmount.ToString("C")</td>
                <td>
                    <span class="badge @(item.OrderStatus == "Completed" ? "bg-success" : "bg-warning")">@item.OrderStatus</span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>
