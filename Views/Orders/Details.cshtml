@model CafeSystem.Models.Order

@{
    ViewData["Title"] = "Order Details";
    bool isAdmin = User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Cashier");
}

<div class="container mt-4">
    <h1>Order #@Model.Id</h1>
    <div class="row">
        <div class="col-md-8">
            <h4>Items</h4>
            <table class="table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Qty</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td>@item.Product.Name</td>
                            <td>@item.UnitPrice.ToString("C")</td>
                            <td>@item.Quantity</td>
                            <td>@((item.UnitPrice * item.Quantity).ToString("C"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header">Order Summary</div>
                <div class="card-body">
                    <p><strong>Date:</strong> @Model.OrderDate</p>
                    <p><strong>Status:</strong> <span class="badge bg-primary">@Model.OrderStatus</span></p>
                    <p><strong>Payment:</strong> @Model.PaymentStatus</p>
                    <h3>Total: @Model.TotalAmount.ToString("C")</h3>
                </div>
            </div>
            
            @if (isAdmin)
            {
                <div class="card">
                    <div class="card-header">Manage Order</div>
                    <div class="card-body">
                        <form asp-action="UpdateStatus" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-3">
                                <label class="form-label">Update Status</label>
                                <select name="status" class="form-select">
                                    <option value="Pending" selected="@(Model.OrderStatus == "Pending")">Pending</option>
                                    <option value="Processing" selected="@(Model.OrderStatus == "Processing")">Processing</option>
                                    <option value="Completed" selected="@(Model.OrderStatus == "Completed")">Completed</option>
                                    <option value="Cancelled" selected="@(Model.OrderStatus == "Cancelled")">Cancelled</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Update Status</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
    <a asp-action="Index" class="btn btn-secondary mt-3">Back to Orders</a>
</div>
