@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="mb-1">Good Morning, Admin! ☕</h2>
        <p class="text-secondary">Here's what's happening in your cafe today.</p>
    </div>
</div>

<!-- Stats Row -->
<div class="row mb-5">
    <div class="col-md-3 mb-4 mb-md-0">
        <div class="stats-card p-4 shadow-sm bg-white">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h6 class="text-secondary text-uppercase fw-bold mb-2" style="font-size: 0.8rem;">Total Revenue</h6>
                    <h3 class="mb-0 fw-bold">$1,250.00</h3>
                    <p class="text-success small mt-2 mb-0"><i class="fas fa-arrow-up"></i> +12% from yesterday</p>
                </div>
                <div class="icon-box bg-coffee bg-opacity-10 text-coffee" style="background-color: rgba(111, 78, 55, 0.1);">
                    <i class="fas fa-dollar-sign"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4 mb-md-0">
        <div class="stats-card p-4 shadow-sm bg-white">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h6 class="text-secondary text-uppercase fw-bold mb-2" style="font-size: 0.8rem;">Total Orders</h6>
                    <h3 class="mb-0 fw-bold">45</h3>
                    <p class="text-success small mt-2 mb-0"><i class="fas fa-arrow-up"></i> +5 new orders</p>
                </div>
                <div class="icon-box bg-caramel bg-opacity-10 text-caramel" style="background-color: rgba(198, 142, 23, 0.1);">
                    <i class="fas fa-shopping-bag"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4 mb-md-0">
        <div class="stats-card p-4 shadow-sm bg-white">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h6 class="text-secondary text-uppercase fw-bold mb-2" style="font-size: 0.8rem;">Active Products</h6>
                    <h3 class="mb-0 fw-bold">28</h3>
                    <p class="text-secondary small mt-2 mb-0">In Stock</p>
                </div>
                <div class="icon-box bg-cream text-coffee" style="background-color: var(--cafe-secondary);">
                    <i class="fas fa-coffee"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card p-4 shadow-sm bg-white">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h6 class="text-secondary text-uppercase fw-bold mb-2" style="font-size: 0.8rem;">Customer Satisfaction</h6>
                    <h3 class="mb-0 fw-bold">4.8</h3>
                    <p class="text-warning small mt-2 mb-0"><i class="fas fa-star"></i> Avg Rating</p>
                </div>
                <div class="icon-box bg-warning bg-opacity-10 text-warning" style="background-color: rgba(255, 193, 7, 0.1);">
                    <i class="fas fa-smile"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions & Categories -->
<div class="row">
    <div class="col-12 mb-4 d-flex justify-content-between align-items-center">
        <h4>Menu Categories</h4>
        <a asp-controller="Categories" asp-action="Create" class="btn btn-cafe"><i class="fas fa-plus me-2"></i>Add Category</a>
    </div>
    
    <!-- Category Grid -->
    <div class="col-md-3 mb-4">
        <div class="cafe-card h-100">
            <img src="~/images/categories/coffee-cat.jpg" alt="Coffee">
            <div class="p-3 text-center">
                <h5>Coffee</h5>
                <p class="text-muted small">Hot & Cold Brews</p>
                <a asp-controller="Products" asp-action="Index" class="text-coffee fw-bold text-decoration-none small">View 12 Items <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="cafe-card h-100">
            <img src="~/images/categories/bakery-cat.jpg" alt="Bakery">
            <div class="p-3 text-center">
                <h5>Bakery</h5>
                <p class="text-muted small">Fresh Pastries</p>
                <a asp-controller="Products" asp-action="Index" class="text-coffee fw-bold text-decoration-none small">View 8 Items <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="cafe-card h-100">
            <img src="~/images/categories/dessert-cat.jpg" alt="Desserts">
            <div class="p-3 text-center">
                <h5>Desserts</h5>
                <p class="text-muted small">Sweet Treats</p>
                <a asp-controller="Products" asp-action="Index" class="text-coffee fw-bold text-decoration-none small">View 5 Items <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="cafe-card h-100">
            <img src="~/images/categories/breakfast-cat.jpg" alt="Breakfast">
            <div class="p-3 text-center">
                <h5>Breakfast</h5>
                <p class="text-muted small">All Day Breakfast</p>
                <a asp-controller="Products" asp-action="Index" class="text-coffee fw-bold text-decoration-none small">View 6 Items <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Orders Table -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white p-4 border-0 d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Recent Orders</h5>
                <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-hover">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 border-0 text-secondary small text-uppercase fw-bold">Order ID</th>
                            <th class="border-0 text-secondary small text-uppercase fw-bold">Customer</th>
                            <th class="border-0 text-secondary small text-uppercase fw-bold">Date</th>
                            <th class="border-0 text-secondary small text-uppercase fw-bold">Amount</th>
                            <th class="border-0 text-secondary small text-uppercase fw-bold">Status</th>
                            <th class="pe-4 border-0 text-secondary small text-uppercase fw-bold text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="ps-4 fw-bold">#1024</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 30px; height: 30px; font-size: 0.8rem;">JS</div>
                                    <span>John Smith</span>
                                </div>
                            </td>
                            <td class="text-muted">Today, 10:30 AM</td>
                            <td class="fw-bold">$12.50</td>
                            <td><span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Completed</span></td>
                            <td class="pe-4 text-end"><button class="btn btn-sm btn-light rounded-circle"><i class="fas fa-ellipsis-v"></i></button></td>
                        </tr>
                        <tr>
                            <td class="ps-4 fw-bold">#1023</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 30px; height: 30px; font-size: 0.8rem;">AL</div>
                                    <span>Alice Lee</span>
                                </div>
                            </td>
                            <td class="text-muted">Today, 09:45 AM</td>
                            <td class="fw-bold">$24.00</td>
                            <td><span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3">Pending</span></td>
                            <td class="pe-4 text-end"><button class="btn btn-sm btn-light rounded-circle"><i class="fas fa-ellipsis-v"></i></button></td>
                        </tr>
                        <tr>
                            <td class="ps-4 fw-bold">#1022</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 30px; height: 30px; font-size: 0.8rem;">MK</div>
                                    <span>Mike K.</span>
                                </div>
                            </td>
                            <td class="text-muted">Yesterday, 5:00 PM</td>
                            <td class="fw-bold">$8.50</td>
                            <td><span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Completed</span></td>
                            <td class="pe-4 text-end"><button class="btn btn-sm btn-light rounded-circle"><i class="fas fa-ellipsis-v"></i></button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
