@model CafeSystem.Models.Product

@{
    ViewData["Title"] = Model.Name;
    ViewData["FullWidth"] = true;
}

<div class="product-detail-wrapper">
    <!-- Left: Immersive Image -->
    <div class="product-detail-left">
         @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            if (Model.ImageUrl.StartsWith("http"))
            {
                <img src="@Model.ImageUrl" class="product-detail-bg" alt="@Model.Name" onerror="this.onerror=null;this.src='/images/hero_bg.png';">
            }
            else
            {
                <img src="~/images/products/@Model.ImageUrl" class="product-detail-bg" alt="@Model.Name" onerror="this.onerror=null;this.src='/images/hero_bg.png';">
            }
        }
        else
        {
            <!-- Fallback to a nice category image if available, else placeholder -->
            <img src="~/images/hero_bg.png" class="product-detail-bg" alt="Ambient Background">
        }
    </div>

    <!-- Right: Elegant Details -->
    <div class="product-detail-right">
        <div class="container-fluid" style="max-width: 700px;">
            <a asp-action="Index" class="text-decoration-none text-muted mb-4 d-inline-block">&larr; Back to Menu</a>
            
            <h5 class="detail-category">@Model.Category?.Name</h5>
            <h1 class="detail-title">@Model.Name</h1>
            <div class="detail-price">@Model.Price.ToString("C")</div>
            
            <p class="detail-desc">
                @Model.Description
                <br>
                <span class="d-block mt-3 fst-italic text-muted">
                    Freshly prepared with premium ingredients. Perfect for a relaxing break.
                </span>
            </p>

            @if (Model.IsAvailable && Model.StockQuantity > 0)
            {
                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    
                    <div class="quantity-wrapper">
                        <label for="quantity" class="fw-bold">Quantity</label>
                        <input type="number" id="quantity" name="quantity" class="input-quantity" value="1" min="1" max="@Model.StockQuantity">
                        <span class="text-success ms-2"><small>In Stock</small></span>
                    </div>

                    <button type="submit" class="btn-add-large">
                        Add to Order &nbsp; 🛍️
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-warning d-inline-block">
                    Currently Out of Stock
                </div>
            }
        </div>
    </div>
</div>
